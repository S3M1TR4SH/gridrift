{
  "persistence": {
    "saveRunOnEveryPlacement": true,
    "storage": "local",
    "trackBestScore": true,
    "welcomeBack": {
      "enabled": true,
      "showBestScore": true,
      "showStreak": true,
      "minAwayMinutes": 30
    }
  },
  "feedback": {
    "clearFx": ["flash", "particles", "scorePopup"],
    "multiClearFx": ["shake", "pitchRise"],
    "maxFxMs": 400,
    "combo": {
      "enabled": true,
      "multiplierPerLine": 1.0,
      "showCounter": true
    },
    "runStreak": {
      "enabled": true,
      "graceMoves": 1,
      "bonusPerStep": 10
    },
    "haptics": {
      "enabled": true,
      "userToggle": true
    },
    "respectReducedMotion": true
  },
  "onboarding": {
    "enabled": true,
    "scriptedBoards": 2,
    "guaranteeFirstClearWithinMoves": 3,
    "textMaxWords": 6,
    "skipForReturningPlayers": true,
    "firstSessionNoInterstitials": true,
    "dragOffsetPx": 60
  },
  "difficulty": {
    "shapePool": "full",
    "minShapes": 15,
    "rampByScore": [[0, "easy"], [300, "normal"], [1200, "hard"]],
    "fairDeal": {
      "guaranteeOnePlaceable": true
    },
    "mercy": {
      "afterLossesInRow": 3,
      "easierDealRuns": 1
    },
    "adIndependentRng": true
  },
  "dailyChallenge": {
    "enabled": true,
    "seed": "utcDate",
    "targetMinutes": [2, 4],
    "objective": "clearLines",
    "objectiveRange": [8, 20],
    "reward": {
      "type": "cosmeticCurrency",
      "amount": 20
    }
  },
  "dayStreak": {
    "enabled": true,
    "countsOn": "dailyChallengeComplete",
    "rolloverHourLocal": 4,
    "freezes": {
      "max": 2,
      "earnEveryNDays": 7,
      "purchasable": false,
      "adOnly": false
    },
    "milestones": [3, 7, 14, 30],
    "milestoneFx": true,
    "lossCopyTone": "neutral"
  }
}
